{
  "schemaVersion": 7,
  "id": "codex",
  "name": "Codex",
  "description": "Uses your ChatGPT plan. Codex can also generate images, so you need one key fewer.",
  "capabilities": {
    "agents": {
      "name": "Agent adapter",
      "description": "Plan and execute editing jobs and report progress."
    },
    "subtitle-translation": {
      "name": "Subtitle translation",
      "description": "Translate timed subtitle cues to a selected language."
    },
    "image-generation": {
      "name": "Image generation",
      "description": "Make thumbnails and other images with Codex's built-in image tool, on your ChatGPT plan."
    }
  },
  "agentProvider": {
    "label": "Codex",
    "setupUrl": "https://learn.chatgpt.com/docs/codex/cli",
    "cli": {
      "executable": "codex",
      "authStatusArgs": [
        "login",
        "status"
      ],
      "structuredRun": {
        "args": [
          "exec",
          "--ignore-rules",
          "--ephemeral",
          "--skip-git-repo-check",
          "--sandbox",
          "read-only",
          "--disable",
          "shell_tool",
          "-c",
          "model_reasoning_summary=\"auto\"",
          "{settings}",
          "{images}",
          "--output-schema",
          "{schemaPath}",
          "--output-last-message",
          "{outputPath}",
          "-"
        ],
        "settingArgs": [
          {
            "setting": "web-search",
            "args": [
              "-c",
              "web_search=\"live\""
            ],
            "otherwise": [
              "-c",
              "web_search=\"disabled\""
            ]
          },
          {
            "setting": "model",
            "args": [
              "-m",
              "{value}"
            ]
          },
          {
            "setting": "reasoning-effort",
            "args": [
              "-c",
              "model_reasoning_effort=\"{value}\""
            ]
          },
          {
            "setting": "installed-plugins",
            "args": [],
            "otherwise": [
              "--ignore-user-config",
              "--disable",
              "plugins"
            ]
          }
        ],
        "imageArgs": [
          "-i",
          "{imagePath}"
        ],
        "progress": [
          {
            "pattern": "^web search: (\\S.*)$",
            "kind": "search"
          },
          {
            "pattern": "^\\*\\*(.+)\\*\\*$",
            "kind": "thinking"
          }
        ],
        "result": {
          "source": "outputFile"
        }
      },
      "imageRun": {
        "args": [
          "exec",
          "--ignore-rules",
          "--ephemeral",
          "--skip-git-repo-check",
          "--sandbox",
          "read-only",
          "--disable",
          "shell_tool",
          "--enable",
          "image_generation",
          "{images}",
          "--json",
          "-"
        ],
        "sessionPointer": "/thread_id",
        "outputDirectory": {
          "env": "CODEX_HOME",
          "fallback": ".codex",
          "path": "generated_images/{session}"
        }
      }
    }
  },
  "settings": [
    {
      "id": "web-search",
      "label": "Web search",
      "description": "Lets the agent search the web while it works, for facts, prices and trends. It stays read-only and cannot run commands.",
      "kind": "boolean",
      "scope": "workspace",
      "required": false,
      "default": false
    },
    {
      "id": "model",
      "label": "Model",
      "description": "The Codex model for this workspace's agent work. Leave empty to use Codex's default.",
      "kind": "string",
      "scope": "workspace",
      "required": false
    },
    {
      "id": "reasoning-effort",
      "label": "Reasoning effort",
      "description": "How long the agent thinks before answering. Higher effort gives better scripts and edits but takes longer.",
      "kind": "string",
      "scope": "workspace",
      "required": false,
      "choices": [
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh"
      ],
      "default": "medium"
    },
    {
      "id": "installed-plugins",
      "label": "Use my installed plugins",
      "description": "Lets the agent use your own Codex configuration, plugins and tool servers. They can see the workspace material the agent is given, so turn this on only for ones you trust.",
      "kind": "boolean",
      "scope": "workspace",
      "required": false,
      "default": false
    }
  ]
}
