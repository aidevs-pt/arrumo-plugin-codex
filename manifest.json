{
  "schemaVersion": 7,
  "id": "codex",
  "name": "Codex",
  "description": "Uses your ChatGPT plan. Codex can also generate images, so you need one key fewer.",
  "capabilities": {
    "agents": {
      "name": "Agent adapter",
      "description": "Plan and execute editing jobs and report progress."
    },
    "subtitle-translation": {
      "name": "Subtitle translation",
      "description": "Translate timed subtitle cues to a selected language."
    }
  },
  "agentProvider": {
    "label": "Codex",
    "setupUrl": "https://learn.chatgpt.com/docs/codex/cli",
    "cli": {
      "executable": "codex",
      "authStatusArgs": [
        "login",
        "status"
      ],
      "structuredRun": {
        "args": [
          "exec",
          "--ignore-user-config",
          "--ignore-rules",
          "--ephemeral",
          "--skip-git-repo-check",
          "--sandbox",
          "read-only",
          "--disable",
          "shell_tool",
          "--disable",
          "plugins",
          "-c",
          "web_search=\"disabled\"",
          "--output-schema",
          "{schemaPath}",
          "--output-last-message",
          "{outputPath}",
          "-"
        ],
        "result": {
          "source": "outputFile"
        }
      }
    }
  }
}
